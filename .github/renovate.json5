{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "rebaseWhen": "conflicted",
  "extends": [
    "config:recommended",
    "github>trueforge-org/renovate-config",
    ":timezone(America/New_York)",    
    ":disableRateLimiting",
    ":semanticCommits",
    ":configMigration",
    "helpers:pinGitHubActionDigests",
    "github>xstar97/home-ops//.github/renovate/semanticCommits.json5",
    "github>xstar97/home-ops//.github/renovate/labels.json5",
    "github>xstar97/home-ops//.github/renovate/autoMerge.json5",
    "github>xstar97/home-ops//.github/renovate/groups.json5",
    "github>xstar97/home-ops//.github/renovate/manual.json5"
  ],
  "ignorePaths": [
    "**/*.sops.*",
    "**/.archive/**",
    "**/archive/**",
    "**/resources/**"
  ]
}