{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "schedule": ["before 06:00 AM"],
  "rebaseWhen": "conflicted",
  "prHourlyLimit": 0,
  "commitHourlyLimit": 0,
  "extends": [
    "config:recommended",
    ":timezone(America/New_York)",    
    ":disableRateLimiting",
    ":semanticCommits",
    ":configMigration",
    "helpers:pinGitHubActionDigests",
    "github>xstar97/home-ops//.github/renovate/customManagers.json5",
    "github>xstar97/home-ops//.github/renovate/kinds.json5",
    "github>xstar97/home-ops//.github/renovate/semanticCommits.json5",
    "github>xstar97/home-ops//.github/renovate/labels.json5",
    "github>xstar97/home-ops//.github/renovate/autoMerge.json5",
    "github>xstar97/home-ops//.github/renovate/groups.json5",
    "github>xstar97/home-ops//.github/renovate/special_grafanadashboard.json5",
    "github>xstar97/home-ops//.github/renovate/minecraft-java.json5",
    "github>xstar97/home-ops//.github/renovate/plex.json5"
  ],
  "ignorePaths": [
    "**/*.sops.*",
    "**/.archive/**",
    "**/archive/**",
    "**/resources/**"
  ]
}