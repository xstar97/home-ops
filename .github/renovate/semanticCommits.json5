{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "feat",
      "commitMessageExtra": "{{currentVersion}} → {{newVersion}}"
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "semanticCommitType": "feat",
      "commitMessageExtra": "{{currentVersion}} → {{newVersion}}"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "semanticCommitType": "fix",
      "commitMessageExtra": "{{currentVersion}} → {{newVersion}}"
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "semanticCommitType": "chore",
      "commitMessageExtra": "digest to {{newDigestShort}}"
    },
    {
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "semanticCommitType": "chore",
      "commitMessageExtra": "digest to {{newDigestShort}}"
    },
    {
      "matchUpdateTypes": [
        "pin"
      ],
      "semanticCommitType": "chore",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "matchManagers": [
        "flux"
      ],
      "semanticCommitScope": "flux",
      "commitMessageTopic": "image {{depName}}",
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "matchManagers": [
        "flux"
      ],
      "semanticCommitScope": "flux",
      "commitMessageTopic": "chart {{depName}}",
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "matchManagers": [
        "kubernetes"
      ],
      "semanticCommitScope": "kubernetes"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "{{depName}}"
    },
    {
      "matchManagers": [
        "devcontainer"
      ],
      "semanticCommitScope": "devcontainer",
      "commitMessageTopic": "image {{depName}}"
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}"
    },
    {
      "matchManagers": [
        "!/flux/",
        "!/devcontainer/"
      ],
      "matchDatasources": [
        "docker"
      ],
      "semanticCommitScope": "deps",
      "commitMessageTopic": "image {{depName}}"
    }
  ]
}
